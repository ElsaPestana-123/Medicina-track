@startuml unidad

' 1. Punto de partida
[*] --> Activo: Se recibe la unidad

state Activo
state Mantenimiento{
    [*]--> Evaluacion: Se detecta un problema o \n se programa mantenimiento preventivo

    state Mantenimiento_Preventivo
    state Reparacion

    Evaluacion --> Mantenimiento_Preventivo: Se determina que el problema es menor o \n se requiere mantenimiento preventivo
    Evaluacion --> Reparacion: Se determina que el problema es mayor o \n se requiere reparación

    Mantenimiento_Preventivo --> [*] : Revisión completada
    Reparacion --> [*] : Reparación exitosa 

}

state Fuera_de_servicio

Activo --> Mantenimiento: Se daña alguna parte de la unidad o \n se requiere mantenimiento preventivo
Mantenimiento --> Activo: Se repara la unidad o \n se completa el mantenimiento preventivo
Activo --> Fuera_de_servicio: La unidad sufre un daño irreparable o \n se retira del servicio
Mantenimiento --> Fuera_de_servicio: La unidad sufre un daño irreparable durante el mantenimiento o \n se decide retirarla del servicio    
Fuera_de_servicio --> [*]: La unidad es retirada definitivamente del servicio

@enduml